APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=
# Optional full path to mysqldump (auto-detected on Laragon / Linux if empty)
MYSQLDUMP_PATH=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

MIM_SMS_API_URL=https://api.mimsms.com/api/SmsSending/SMS
MIM_SMS_USERNAME=
MIM_SMS_API_KEY=
MIM_SMS_SENDER_NAME=
MIM_SMS_TRANSACTION_TYPE=T

# EPS live — BaseUrl in EPS portal = affsell.com
# Tenant callbacks go to https://{tenant}.affsell.com/api/aaparpay/... (Laravel), then redirect to dashboard
EPS_SANDBOX=false
# Must match EPS merchant portal BaseUrl
EPS_BASE_URL=https://affsell.com
# Real Laravel API
EPS_API_URL=https://mdperves.info
# Optional instant browser callback host under affsell.com pointing to Laravel:
# EPS_CALLBACK_HOST=pay.affsell.com
EPS_CALLBACK_HOST=
EPS_USERNAME=
EPS_PASSWORD=
EPS_MERCHANT_ID=
EPS_STORE_ID=
EPS_HASH_KEY=
EPS_TRANSACTION_TYPE_ID=1
# Payments complete automatically via background poller (no artisan command needed).

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# cPanel Configuration
CPANEL_USER=
CPANEL_PASSWORD=
CPANEL_HOST=
MAIN_DOMAIN=
# Default tenant root: "public_html/storeeb.com/public" or "storeeb.com/public" depending on server structure
CPANEL_TENANT_ROOT="public_html/storeeb.com/public"
# PHP version for new subdomains in production. Use cPanel format: ea-php82 (PHP 8.2), ea-php81 (8.1), ea-php74 (7.4).
CPANEL_PHP_VERSION=ea-php82
